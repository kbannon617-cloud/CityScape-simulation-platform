# Copy this file to .env and fill in real values. .env is git-ignored.

# --- SQL Server connection ---
# Set CINIS_DB_AUTH to "windows" for Windows/Trusted authentication (typical for local
# SSMS installs) or "sql" for SQL Server login authentication.
CINIS_DB_AUTH=windows

CINIS_DB_SERVER=localhost\SQLEXPRESS
CINIS_DB_NAME=CityScapeDev
CINIS_DB_DRIVER=ODBC Driver 17 for SQL Server

# Only required when CINIS_DB_AUTH=sql
CINIS_DB_USER=
CINIS_DB_PASSWORD=

# --- Application ---
CINIS_ENV=development
CINIS_LOG_LEVEL=INFO
